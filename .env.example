# Sem nenhuma variável o demo roda 100% offline:
# PGlite (Postgres em WASM com pgvector), embeddings locais e um gerador offline no lugar do LLM.

# --- Banco ---
# Supabase/Postgres com pgvector. Vazio = PGlite em .data/pglite
DATABASE_URL=

# --- LLM ---
# anthropic | offline
LLM_PROVIDER=offline
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Preço por milhão de tokens, para estimar custo nos traces (ajuste para o modelo usado)
LLM_PRICE_INPUT_PER_MTOK=3
LLM_PRICE_OUTPUT_PER_MTOK=15

# --- Embeddings ---
# local | openai  (a dimensão precisa bater com a migration: 512)
EMBEDDINGS_PROVIDER=local
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- RAG ---
RAG_TOP_K=8
RAG_MIN_SIMILARITY=0.05

# --- Observabilidade ---
# Endpoint OTLP/HTTP opcional (Jaeger, Grafana Tempo, Langfuse...). Os spans sempre vão para .data/traces.jsonl
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_CONSOLE=0
# Webhook opcional para publicar o relatório semanal num canal do Teams
TEAMS_WEBHOOK_URL=

PORT=5173
