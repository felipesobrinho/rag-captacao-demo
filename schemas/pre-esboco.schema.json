{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/felipesobrinho/rag-captacao-demo/schemas/pre-esboco.schema.json",
  "title": "PreEsboco",
  "description": "Pré-esboço de projeto gerado pelo agente. Sempre nasce como rascunho e só segue após triagem humana.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "titulo",
    "status",
    "resumo",
    "problema",
    "objetivos",
    "escopo_mvp",
    "fora_do_escopo",
    "historias_sugeridas",
    "integracoes_possiveis",
    "riscos",
    "perguntas_para_entendimento",
    "projetos_relacionados",
    "fontes",
    "lacunas",
    "confianca"
  ],
  "properties": {
    "titulo": { "type": "string", "minLength": 5, "maxLength": 120 },
    "status": { "type": "string", "enum": ["rascunho"] },
    "resumo": { "type": "string", "minLength": 20, "maxLength": 700 },
    "problema": { "type": "string", "minLength": 20, "maxLength": 900 },
    "objetivos": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": { "type": "string", "minLength": 5 }
    },
    "escopo_mvp": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "type": "string", "minLength": 5 }
    },
    "fora_do_escopo": {
      "type": "array",
      "maxItems": 6,
      "items": { "type": "string", "minLength": 3 }
    },
    "historias_sugeridas": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["como", "quero", "para", "criterios"],
        "properties": {
          "como": { "type": "string", "minLength": 3 },
          "quero": { "type": "string", "minLength": 5 },
          "para": { "type": "string", "minLength": 5 },
          "criterios": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["dado", "quando", "entao"],
              "properties": {
                "dado": { "type": "string", "minLength": 3 },
                "quando": { "type": "string", "minLength": 3 },
                "entao": { "type": "string", "minLength": 3 }
              }
            }
          }
        }
      }
    },
    "integracoes_possiveis": {
      "type": "array",
      "maxItems": 6,
      "items": { "type": "string", "minLength": 3 }
    },
    "riscos": {
      "type": "array",
      "maxItems": 6,
      "items": { "type": "string", "minLength": 5 }
    },
    "perguntas_para_entendimento": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "type": "string", "minLength": 5 }
    },
    "projetos_relacionados": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["documento_id", "titulo", "motivo"],
        "properties": {
          "documento_id": { "type": "string" },
          "titulo": { "type": "string" },
          "motivo": { "type": "string", "minLength": 5 }
        }
      }
    },
    "fontes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["chunk_id", "uso"],
        "properties": {
          "chunk_id": { "type": "string", "pattern": "^[a-z0-9-]+#[0-9]{2}$" },
          "uso": { "type": "string", "minLength": 5 }
        }
      }
    },
    "lacunas": {
      "type": "array",
      "maxItems": 8,
      "items": { "type": "string", "minLength": 5 }
    },
    "confianca": { "type": "string", "enum": ["baixa", "media", "alta"] }
  }
}
